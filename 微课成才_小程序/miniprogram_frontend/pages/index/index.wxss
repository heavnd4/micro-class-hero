.container {
  padding: 20rpx;
  background-color: #f5f7fa;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
  padding: 30rpx;
  border-radius: 20rpx;
  color: white;
  margin-bottom: 30rpx;
}

.hero-display {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.hero-img {
  width: 120rpx;
  height: 120rpx;
  margin-right: 30rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 60rpx;
  border: 2rpx solid #00f2fe;
}

.hero-info {
  display: flex;
  flex-direction: column;
}

.hero-name {
  font-size: 38rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
}

.hero-title {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 6rpx;
}

.status-bar {
  height: 10rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 5rpx;
  margin: 20rpx 0;
  overflow: hidden;
}

.progress {
  height: 100%;
  background: #00f2fe;
  transition: width 0.3s;
}

.video-section {
  width: 100%;
  margin-bottom: 30rpx;
}

video {
  width: 100%;
  border-radius: 10rpx;
}

.q-card {
  background: white;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.q-type {
  color: #2a5298;
  font-weight: bold;
}

.options {
  margin-top: 30rpx;
}

.opt-btn {
  margin-bottom: 20rpx;
  background: white;
  border: 1rpx solid #ddd;
  font-size: 28rpx;
  transition: all 0.2s;
}

.opt-btn.selected {
  background: #e3f2fd;
  border-color: #2a5298;
  color: #2a5298;
  font-weight: bold;
  transform: scale(1.02);
}

.submit-btn {
  margin-top: 30rpx;
  border-radius: 10rpx;
  font-weight: bold;
}

.quiz-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

.quiz-progress {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.exit-quiz-btn {
  font-size: 24rpx;
  color: #999;
  background: #f0f0f0;
  border: none;
}

.short-answer-area {
  margin-top: 30rpx;
}

.short-answer-input {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 10rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fafafa;
}

.result-card {
  text-align: center;
  padding: 60rpx 30rpx;
}

.result-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2a5298;
  display: block;
  margin-bottom: 20rpx;
}

.result-text {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 40rpx;
}

.warmup-hint {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #ff9800;
  margin-top: 16rpx;
}

/* 调试模式按钮 */
.quiz-header-right {
  display: flex;
  gap: 10rpx;
}

.debug-btn {
  font-size: 22rpx;
  color: #e91e63;
  background: #fce4ec;
  border: 1rpx solid #e91e63;
  padding: 0 16rpx;
  line-height: 1.6;
}

.debug-toolbar {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  margin-bottom: 8rpx;
}

/* 冷启动等待覆盖层 */
.cold-start-overlay {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.cold-start-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.4; transform: scale(0.95); }
  50% { opacity: 1; transform: scale(1.05); }
}

.cold-start-text {
  font-size: 30rpx;
  color: #666;
  line-height: 1.8;
}

.cold-start-text secondary {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.debug-tag {
  font-size: 20rpx;
  color: #ff6f00;
  background: #fff3e0;
  border: 1rpx solid #ffb74d;
  padding: 0 20rpx;
  line-height: 1.8;
  border-radius: 20rpx;
}